  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Sapo Wilson, um lend\xE1rio ca\xE7ador de tesouros, ouviu rumores sobre
    a lend\xE1ria Ma\xE7\xE3 Dourada Gigante, um objeto m\xE1gico protegido por um
    drag\xE3o, dita capaz de salvar o mundo!\n\nPara encontr\xE1-la, ele atravessou
    a fronteira rumo ao Mundo Encantado: um lugar deslumbrante e extremamente hostil.\n\nL\xE1,
    descobriu que precisaria coletar todas as 30 pequenas ma\xE7\xE3s douradas que
    o levariam ao reduto do drag\xE3o e, finalmente, at\xE9 a lend\xE1ria Ma\xE7\xE3
    Dourada Gigante.\n\nAgora, s\xF3 resta uma coisa a fazer: correr, e recolher
    todas as ma\xE7\xE3s antes que o Mundo Encantado o engula por completo."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: ec98d6917dea07140980db1471f0ace3, type: 2}
  m_sharedMaterial: {fileID: 2100000, guid: f68760c9c6e167d48a75344bdb54622e, type: 2}
