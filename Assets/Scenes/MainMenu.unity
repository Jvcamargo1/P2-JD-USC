  m_text: "<align=center><color=#FFD64A>DESENVOLVIDO POR</color>\nJo\xE3o Vitor Camargo\n\n<color=#FFD64A>DISCIPLINA</color>\nDesenvolvimento
    de Jogos Digitais\nCi\xEAncia da Computa\xE7\xE3o \u2014 USC\n\n<color=#FFD64A>AGRADECIMENTO
    ESPECIAL</color>\nAo professor Luis Filipe Grael Tinos\n\n<color=#FFD64A>ARTE
